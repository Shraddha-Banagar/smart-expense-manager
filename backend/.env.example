# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_manager

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI
GEMINI_API_KEY=your-gemini-api-key
# Which provider extract-expense/insights calls use: "gemini" (default, per spec) or "anthropic"
LLM_PROVIDER=gemini
# Optional: only needed if LLM_PROVIDER=anthropic (useful for local dev/testing
# without a Gemini key; not required for production)
ANTHROPIC_API_KEY=

# Storage: "local" or "cloudinary"
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
FRONTEND_URL=http://localhost:5173
